APP_NAME=Dot.Sheet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production is SQLite (cPanel shared host). A relative DB_DATABASE is resolved
# from the project root; leave it unset to use database/database.sqlite.
# On the host use an absolute path, e.g. /home/<user>/dot-sheet/database/database.sqlite.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# Concurrent web + queue + cron writers (defaults shown, see config/database.php):
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE=wal
# DB_SYNCHRONOUS=normal
# DB_TRANSACTION_MODE=IMMEDIATE

# Imports: a file with fewer non-empty CELLS than this is written inside the request in one
# all-or-nothing transaction (about 0.2-0.35 ms of SQLite write lock per cell, so 6000 cells is
# 1-2 seconds); a bigger one is split into queued chunk jobs of about SHEET_IMPORT_CHUNK_CELLS
# cells each, with a pause between them so sessions and the scheduler can write (defaults shown).
# SHEET_IMPORT_INLINE_MAX_CELLS=6000
# SHEET_IMPORT_CHUNK_CELLS=5000
# SHEET_IMPORT_CHUNK_PAUSE_MS=250

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# No websocket server exists in production, so broadcasting is off. The browser
# Echo client only connects when VITE_PUSHER_APP_KEY / VITE_REVERB_APP_KEY is set
# at build time, so leave these keys empty unless you run a Reverb/Pusher server.
BROADCAST_CONNECTION=null

# Realtime Collaboration (optional; only with a websocket server and BROADCAST_CONNECTION=reverb|pusher)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=6001
PUSHER_SCHEME=http

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Ecosystem SSO — hub URL for cross-platform token issuance
INFODOT_URL=https://infodot.app

# Ecosystem SSO: InfoDot proves handoff tokens (this app has its own database).
# INFODOT_SERVICE_SECRET must equal ECOSYSTEM_SECRET_<KEY> in InfoDot's .env, and
# INFODOT_PLATFORM_KEY must be this platform's key there. Leave the secret blank to
# keep the old local-token-only behaviour.
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=sheet
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true

# AI provider for formula generation / analysis / NLQ (see config/ai.php).
# "mock" is a safe local/CI default — no live provider needed, mirrors
# Dot.Press's AI_PROVIDER=mock. Set to "anthropic" + ANTHROPIC_API_KEY for
# a real Claude connection.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# User scripts (JavaScript saved in a spreadsheet and run in the browser) are off.
# The web worker they run in is not a sandbox: see config/sheet.php before turning this on.
SHEET_SCRIPTS_ENABLED=false
# Largest sheet the Excel export builds (cells); above it the CSV export is offered.
# SHEET_EXPORT_EXCEL_MAX_CELLS=50000

# Insert/delete of rows and columns stays off until the multi-process race test has passed on the host (see config/sheet.php).
SHEET_STRUCTURE_OPS_ENABLED=false

# Public sign-up is closed; InfoDot creates accounts at first sign-in. Set true only for a deliberate window.
ALLOW_REGISTRATION=false
