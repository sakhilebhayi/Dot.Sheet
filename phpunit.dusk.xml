<?xml version="1.0" encoding="UTF-8"?>
<!-- Browser tests (php artisan dusk). They drive the app served by `php artisan serve` and must share its
     database, so nothing here may force an in-memory one (the old setting did, which is why the users a
     test made never existed for the browser): .env decides, the file database CI prepares. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>

    <php>
        <env name="MAIL_MAILER" value="array"/>
        <env name="DUSK_DRIVER_URL" value="http://localhost:9515"/>
    </php>
</phpunit>
