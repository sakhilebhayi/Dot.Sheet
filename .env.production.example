APP_NAME=Dot.Sheet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

LOG_CHANNEL=stack
LOG_LEVEL=info

# cPanel shared host: SQLite, no Redis, no Node, no websocket server.
# cron runs `schedule:run` and `queue:work`.
DB_CONNECTION=sqlite
# Absolute path to the SQLite file on the host (must be writable by the app user,
# together with its directory: SQLite needs to create the -wal / -shm files).
DB_DATABASE=/home/CPANEL_USER/dot-sheet/database/database.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=wal
DB_SYNCHRONOUS=normal
DB_TRANSACTION_MODE=IMMEDIATE

# Imports: a file with fewer non-empty CELLS than this is written inside the request in one
# all-or-nothing transaction (about 0.2-0.35 ms of SQLite write lock per cell, so 6000 cells is
# 1-2 seconds); a bigger one is split into queued chunk jobs of about SHEET_IMPORT_CHUNK_CELLS
# cells each, with a pause between them so sessions and the scheduler can write (defaults shown).
SHEET_IMPORT_INLINE_MAX_CELLS=6000
SHEET_IMPORT_CHUNK_CELLS=5000
SHEET_IMPORT_CHUNK_PAUSE_MS=250

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# No websocket server: broadcasting stays off and the browser never connects.
# Do not set PUSHER_* / REVERB_* / VITE_PUSHER_* / VITE_REVERB_* keys here.
BROADCAST_CONNECTION=null

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

AI_PROVIDER=ollama
AI_MODEL=mistral
AI_BASE_URL=http://localhost:11434
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_RPH=1000
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600

BACKUP_RETENTION_DAYS=14
BACKUP_DISK=local

# User scripts (JavaScript saved in a spreadsheet and run in the browser) stay off: the web worker is not a sandbox (see config/sheet.php).
SHEET_SCRIPTS_ENABLED=false

# Insert/delete of rows and columns stays off until the multi-process race test has passed on the host (see config/sheet.php).
SHEET_STRUCTURE_OPS_ENABLED=false
